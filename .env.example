# ═══════════════════════════════════════════
# EduAgent 环境变量配置
# cp .env.example .env 然后填入实际值
# ═══════════════════════════════════════════

# ──────────────────────────────────────────
# LLM 配置（改这三行就能切模型）
# ──────────────────────────────────────────

LLM_API_KEY=sk-your_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 各 provider 参考：
# 通义千问：  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# DeepSeek：   LLM_BASE_URL=https://api.deepseek.com/v1                        LLM_MODEL=deepseek-chat
# 讯飞星火：   LLM_BASE_URL=https://spark-api-open.xf-yun.com/v1               LLM_MODEL=spark-4.0
# 智谱 GLM：   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-4
# Kimi：       LLM_BASE_URL=https://api.moonshot.cn/v1                         LLM_MODEL=moonshot-v1-8k
# OpenAI：     LLM_BASE_URL=https://api.openai.com/v1                          LLM_MODEL=gpt-4o
# Ollama本地： LLM_BASE_URL=http://localhost:11434/v1                          LLM_MODEL=qwen2.5:32b

# ──────────────────────────────────────────
# 多模态生成（可选）
# ──────────────────────────────────────────

# 讯飞 SeeDance 视频生成
SEEDANCE_API_KEY=your_key_here
SEEDANCE_API_SECRET=your_secret_here

# TTS 语音合成
TTS_PROVIDER=xunfei
XUNFEI_TTS_APP_ID=your_app_id_here
XUNFEI_TTS_API_KEY=your_key_here
XUNFEI_TTS_API_SECRET=your_secret_here

# ASR / OCR
XUNFEI_ASR_APP_ID=your_app_id_here
XUNFEI_ASR_API_KEY=your_key_here
XUNFEI_OCR_APP_ID=your_app_id_here
XUNFEI_OCR_API_KEY=your_key_here

# ──────────────────────────────────────────
# DeepTutor
# ──────────────────────────────────────────
DEEPTUTOR_ADMIN_KEY=change_me_in_production
