APP_NAME=eduagent-backend
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ── 科大讯飞 星火多模态（图片 / 视觉 / 视频脚本）────
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_IMAGE_HOST_URL=https://spark-api.cn-huabei-1.xf-yun.com/v2.1/tti
SPARK_VISION_APP_ID=
SPARK_VISION_API_KEY=
SPARK_VISION_API_SECRET=

# ── Qwen / DashScope（通义千问 VL 视觉 + 图片生成）─────
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus
QWEN_IMAGE_MODEL=qwen-image

# ── Wan Video（通义万相 视频生成）─────────────────────────
WAN_VIDEO_MODEL=wanx2.1-t2v-turbo
# DASHSCOPE_API_KEY is an alias for QWEN_API_KEY if both share the same key
DASHSCOPE_API_KEY=

# Search provider settings
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=10
SEARCH_TOTAL_TIMEOUT=15
SEARCH_PROXY=
SEARCH_CACHE_TTL=300

# RAG / Vector Search
RAG_ENABLED=true
RAG_INDEX_PATH=./data/faiss/eduagent_knowledge.faiss
HF_HOME=./data/huggingface_cache
