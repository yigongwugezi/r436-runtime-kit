# ══════════════════════════════════════════════════════════════════
# AI 凭据已迁移至每用户配置（系统设置 → AI 模型配置）
# ------------------------------------------------------------------
# 所有 API key / secret / app_id 不再从 .env 读取：每个登录用户在前端
# "系统设置 → AI 模型配置" 中独立填写自己的密钥（存 user_ai_config 表，
# 默认为空，用户之间互不可见）。本文件只保留技术性配置：超时、重试、
# 端点 URL、模型微调、搜索/缓存/熔断参数等。
# ══════════════════════════════════════════════════════════════════
APP_NAME=eduagent-backend
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# LLM_PROVIDER=user：真实提供商由每个用户在系统设置中选择（默认部署值）。
# LLM_PROVIDER=mock 是自动化测试逃生舱：未配置用户密钥时返回确定性模拟输出；
# 已配置用户密钥时始终走真实调用（用户配置优先于本开关）。
LLM_PROVIDER=user
LLM_TEMPERATURE=0.2

# ── 科大讯飞 星火多模态（技术项：仅端点 URL；凭据在用户配置）────
SPARK_IMAGE_HOST_URL=https://spark-api.cn-huabei-1.xf-yun.com/v2.1/tti

# ── Qwen / DashScope（技术项：端点与模型名微调；key 在用户配置）─────
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus
QWEN_IMAGE_MODEL=qwen-image

# ── Wan Video（技术项：模型名；key 在用户配置）─────────────────────
WAN_VIDEO_MODEL=wanx2.1-t2v-turbo

# ── 角色模型微调（可选技术项：为特定角色指定 provider/model）──────
# 角色使用的 key 仍来自用户配置：主模型同提供商→共用主 key，
# 不同提供商→读用户配置中对应服务条目（qwen/glm/openai）的 key。
#LLM_PLANNER_PROVIDER=deepseek
#LLM_PLANNER_MODEL=
#LLM_CODER_PROVIDER=qwen
#LLM_CODER_MODEL=
#LLM_CRITIC_PROVIDER=qwen
#LLM_CRITIC_MODEL=
#LLM_NARRATOR_PROVIDER=deepseek
#LLM_NARRATOR_MODEL=

# Search provider settings（Tavily key 在用户配置）
SEARCH_PROVIDER=mock
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=10
SEARCH_TOTAL_TIMEOUT=15
SEARCH_PROXY=
SEARCH_CACHE_TTL=300

# Free-first section recommendation cascade. No paid provider is enabled here.
SEARCH_STRATEGY=free_first_cascade
SEARCH_PROVIDER_TIMEOUT_SECONDS=5
SEARCH_TOTAL_TIMEOUT_SECONDS=12
SEARCH_MAX_PROVIDER_CALLS=8
SEARCH_PRIMARY_GRACE_SECONDS=1.5
SEARCH_PROVIDER_HARD_TIMEOUT_SECONDS=3.5
SEARCH_TOTAL_TIMEOUT_SINGLE_SECONDS=8
SEARCH_TOTAL_TIMEOUT_ALL_SECONDS=10
SEARCH_MAX_CONCURRENT_PROVIDERS=2
SEARCH_MIN_RESULTS_SINGLE_TYPE=6
SEARCH_MAX_RESULTS_SINGLE_TYPE=8
SEARCH_MIN_RESULTS_ALL=8
SEARCH_MAX_RESULTS_ALL=12
SEARCH_MIN_TYPES_ALL=3
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_STALE_CACHE_SECONDS=604800
SEARCH_CACHE_MAX_ENTRIES=500
SEARCH_CIRCUIT_FAILURE_THRESHOLD=3
SEARCH_CIRCUIT_OPEN_SECONDS=60
SEARCH_DYNAMIC_PROVIDER_ORDER_ENABLED=true
SEARCH_RESET_CLIENT_ON_NETWORK_ERROR=true

# RAG / Vector Search
RAG_ENABLED=true
RAG_INDEX_PATH=./data/faiss/eduagent_knowledge.faiss
HF_HOME=./data/huggingface_cache
WORKFLOW_TASK_TTL_SECONDS=1800
WORKFLOW_TASK_MAX_ENTRIES=500
WORKFLOW_EVENT_BUFFER_MAX=200
WORKFLOW_PREVIEW_MAX_CHARS=12000
WORKFLOW_PROGRESS_EVENT_THROTTLE_MS=100
WORKFLOW_MAX_CONCURRENT_TASKS_PER_USER=3
WORKFLOW_HEARTBEAT_SECONDS=15
